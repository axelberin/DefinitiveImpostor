      m_Items:
      - rid: 4311677712361063337
  - m_Id: 2434849230401589
    m_Localized: 'Impostores:'
    m_Metadata:
      m_Items:
      - rid: 4311677712361063338
  - m_Id: 2434849230401590
    m_Localized: 'Palabra secreta:'
    m_Metadata:
      m_Items:
      - rid: 4311677712361063339
  - m_Id: 2434849230401591
    m_Localized: Jugar de nuevo
    m_Metadata:
      m_Items:
      - rid: 4311677712361063340
  - m_Id: 2434849230401592
    m_Localized: "Volver al Men\xFA"
    m_Metadata:
      m_Items:
      - rid: 4311677712361063341
  - m_Id: 2434849230401593
    m_Localized: Cerrar
    m_Metadata:
      m_Items:
      - rid: 4311677712361063342
  - m_Id: 2434849230401594
    m_Localized: Falta asignar WordDatabase en el Inspector.
    m_Metadata:
      m_Items:
      - rid: 4311677712361063343
  - m_Id: 2434849230401595
    m_Localized: "La configuraci\xF3n de la partida no existe."
    m_Metadata:
      m_Items:
      - rid: 4311677712361063344
  - m_Id: 2434849230401596
    m_Localized: "Necesit\xE1s al menos 3 jugadores."
    m_Metadata:
      m_Items:
      - rid: 4311677712361063345
  - m_Id: 2434849230401597
    m_Localized: "Ten\xE9s que habilitar al menos una categor\xEDa."
    m_Metadata:
      m_Items:
      - rid: 4311677712361063346
  - m_Id: 2434849230401598
    m_Localized: "Ten\xE9s que elegir al menos 1 impostor."
    m_Metadata:
      m_Items:
      - rid: 4311677712361063347
  - m_Id: 2434849230401599
    m_Localized: La cantidad de impostores tiene que ser menor a la cantidad de jugadores.
    m_Metadata:
      m_Items:
      - rid: 4311677712361063348
  - m_Id: 2434849230401600
    m_Localized: "La partida todav\xEDa no empez\xF3."
    m_Metadata:
      m_Items:
      - rid: 4311677712361063349
  - m_Id: 2434849230401601
    m_Localized: "La configuraci\xF3n de la partida no es v\xE1lida."
    m_Metadata:
      m_Items:
      - rid: 4311677712361063350
  - m_Id: 2434849230401602
    m_Localized: No hay una palabra seleccionada.
    m_Metadata:
      m_Items:
      - rid: 4311677712361063351
  - m_Id: 2434849230401603
