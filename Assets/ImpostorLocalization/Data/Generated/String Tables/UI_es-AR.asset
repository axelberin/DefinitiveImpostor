      m_Items:
      - rid: 4311677738384361135
  - m_Id: 2851219847884868
    m_Localized: "El jugador seleccionado no es v\xE1lido."
    m_Metadata:
      m_Items:
      - rid: 4311677738384361136
  - m_Id: 2851219847884869
    m_Localized: El jugador seleccionado no pertenece a esta partida.
    m_Metadata:
      m_Items:
      - rid: 4311677738384361137
  - m_Id: 2851219847884870
    m_Localized: "El \xEDndice del jugador seleccionado no es v\xE1lido."
