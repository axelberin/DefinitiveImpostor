    m_Localized: Mujer Maravilla
    m_Metadata:
      m_Items:
      - rid: 4311677738384359724
  - m_Id: 2851221118759223
    m_Localized: "Es una hero\xEDna de DC, princesa amazona y guerrera con habilidades
      sobrehumanas."
