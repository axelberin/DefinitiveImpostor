      m_Items:
      - rid: 4311677717029060733
  - m_Id: 2509537356918835
    m_Localized: Italia
    m_Metadata:
      m_Items:
      - rid: 4311677717029060734
  - m_Id: 2509537356918836
    m_Localized: "Pa\xEDs mediterr\xE1neo famoso por su historia, arte, costas y
      platos como la pasta y la pizza."
    m_Metadata:
      m_Items:
      - rid: 4311677717029060735
  - m_Id: 2509537356918837
    m_Localized: Alemania
    m_Metadata:
      m_Items:
      - rid: 4311677717029060736
  - m_Id: 2509537356918838
    m_Localized: "Pa\xEDs de Europa central reconocido por su ingenier\xEDa, industria
      automotriz y compleja historia moderna."
    m_Metadata:
      m_Items:
      - rid: 4311677717029060737
  - m_Id: 2509537356918839
    m_Localized: "Jap\xF3n"
    m_Metadata:
      m_Items:
      - rid: 4311677717029060738
  - m_Id: 2509537356918840
    m_Localized: "Pa\xEDs insular de Asia oriental donde conviven tradiciones antiguas,
      tecnolog\xEDa, anime y cultura pop."
    m_Metadata:
      m_Items:
      - rid: 4311677717029060739
  - m_Id: 2509537356918841
    m_Localized: China
    m_Metadata:
      m_Items:
      - rid: 4311677717029060740
  - m_Id: 2509537356918842
    m_Localized: "Pa\xEDs de Asia oriental con una historia milenaria, una poblaci\xF3n
      enorme y monumentos como la Gran Muralla."
    m_Metadata:
      m_Items:
      - rid: 4311677717029060741
  - m_Id: 2509537356918843
    m_Localized: Australia
    m_Metadata:
      m_Items:
      - rid: 4311677717029060742
  - m_Id: 2509537356918844
    m_Localized: "Pa\xEDs y continente conocido por fauna \xFAnica, playas inmensas,
      arrecifes y paisajes des\xE9rticos."
