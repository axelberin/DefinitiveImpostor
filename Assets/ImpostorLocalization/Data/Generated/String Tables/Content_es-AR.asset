      m_Items:
      - rid: 4311677738384359729
  - m_Id: 2851221118759228
    m_Localized: Thor
    m_Metadata:
      m_Items:
      - rid: 4311677738384359730
  - m_Id: 2851221118759229
    m_Localized: "Es un h\xE9roe de Marvel inspirado en la mitolog\xEDa n\xF3rdica,
      asociado al trueno y a un arma m\xE1gica."
    m_Metadata:
      m_Items:
      - rid: 4311677738384359731
  - m_Id: 2851221118759230
    m_Localized: Hulk
