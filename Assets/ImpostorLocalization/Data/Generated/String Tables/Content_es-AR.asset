      m_Items:
      - rid: 4311677738384359735
  - m_Id: 2851221118759234
    m_Localized: Doctor Strange
    m_Metadata:
      m_Items:
      - rid: 4311677738384359736
  - m_Id: 2851221118759235
    m_Localized: "Es un h\xE9roe de Marvel que utiliza artes m\xEDsticas para proteger
      la realidad."
    m_Metadata:
      m_Items:
      - rid: 4311677738384359737
  - m_Id: 2851221118759236
