      m_Items:
      - rid: 4311677717029060753
  - m_Id: 2509537356918855
    m_Localized: Milanesa
    m_Metadata:
      m_Items:
      - rid: 4311677717029060754
  - m_Id: 2509537356918856
    m_Localized: "Filete empanado y cocido al horno o frito, un cl\xE1sico absoluto
      de las mesas argentinas."
    m_Metadata:
      m_Items:
      - rid: 4311677717029060755
  - m_Id: 2509537356918857
    m_Localized: Asado
    m_Metadata:
      m_Items:
      - rid: 4311677717029060756
  - m_Id: 2509537356918858
    m_Localized: Carne y otros alimentos cocinados lentamente a la parrilla, ritual
      social argentino por excelencia.
    m_Metadata:
      m_Items:
      - rid: 4311677717029060757
  - m_Id: 2509537356918859
    m_Localized: Sushi
    m_Metadata:
      m_Items:
      - rid: 4311677717029060758
  - m_Id: 2509537356918860
    m_Localized: "Preparaci\xF3n japonesa de arroz sazonado combinado con pescado,
      mariscos, vegetales u otros ingredientes."
    m_Metadata:
      m_Items:
      - rid: 4311677717029060759
  - m_Id: 2509537356918861
    m_Localized: Taco
