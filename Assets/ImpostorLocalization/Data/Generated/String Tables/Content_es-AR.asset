      m_Items:
      - rid: 4311677717029060743
  - m_Id: 2509537356918845
    m_Localized: Egipto
    m_Metadata:
      m_Items:
      - rid: 4311677717029060744
  - m_Id: 2509537356918846
    m_Localized: "Pa\xEDs del noreste de \xC1frica atravesado por el Nilo y famoso
      por sus pir\xE1mides y civilizaci\xF3n antigua."
    m_Metadata:
      m_Items:
      - rid: 4311677717029060745
  - m_Id: 2509537356918847
    m_Localized: "Sud\xE1frica"
    m_Metadata:
      m_Items:
      - rid: 4311677717029060746
  - m_Id: 2509537356918848
    m_Localized: "Pa\xEDs del extremo sur de \xC1frica conocido por su diversidad
      cultural, ciudades costeras y grandes reservas naturales."
    m_Metadata:
      m_Items:
      - rid: 4311677717029060747
  - m_Id: 2509537356918849
    m_Localized: Pizza
    m_Metadata:
      m_Items:
      - rid: 4311677717029060748
  - m_Id: 2509537356918850
    m_Localized: Masa horneada cubierta con salsa, queso y una cantidad casi infinita
      de ingredientes posibles.
    m_Metadata:
      m_Items:
      - rid: 4311677717029060749
  - m_Id: 2509537356918851
    m_Localized: Hamburguesa
    m_Metadata:
      m_Items:
      - rid: 4311677717029060750
  - m_Id: 2509537356918852
    m_Localized: "Medall\xF3n de carne o vegetales servido en pan y acompa\xF1ado
      con salsas, queso y otros agregados."
