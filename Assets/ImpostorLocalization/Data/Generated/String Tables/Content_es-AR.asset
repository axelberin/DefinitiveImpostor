  - m_Id: 2851221118759217
    m_Localized: "Es un superh\xE9roe de Marvel con poderes ar\xE1cnidos, agilidad
      y sentido de peligro."
    m_Metadata:
      m_Items:
      - rid: 4311677738384359719
  - m_Id: 2851221118759218
    m_Localized: Batman
