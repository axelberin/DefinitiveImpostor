      m_Items:
      - rid: 4311677717029060760
  - m_Id: 2509537356918862
    m_Localized: "Tortilla doblada alrededor de un relleno, acompa\xF1ada con salsas
      y guarniciones."
    m_Metadata:
      m_Items:
      - rid: 4311677717029060761
  - m_Id: 2509537356918863
    m_Localized: Pasta
    m_Metadata:
      m_Items:
      - rid: 4311677717029060762
  - m_Id: 2509537356918864
    m_Localized: Alimento hecho principalmente con harina y agua, servido en numerosas
      formas y con distintas salsas.
    m_Metadata:
      m_Items:
      - rid: 4311677717029060763
  - m_Id: 2509537356918865
