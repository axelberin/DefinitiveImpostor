      m_Items:
      - rid: 4311677738384359725
  - m_Id: 2851221118759224
    m_Localized: Iron Man
    m_Metadata:
      m_Items:
      - rid: 4311677738384359726
  - m_Id: 2851221118759225
    m_Localized: "Es un h\xE9roe de Marvel que usa armaduras tecnol\xF3gicas creadas
      por Tony Stark."
    m_Metadata:
      m_Items:
      - rid: 4311677738384359727
  - m_Id: 2851221118759226
    m_Localized: "Capit\xE1n Am\xE9rica"
    m_Metadata:
      m_Items:
      - rid: 4311677738384359728
  - m_Id: 2851221118759227
    m_Localized: "Es un h\xE9roe de Marvel, s\xEDmbolo de justicia y resultado de
      un experimento militar."
