      m_Items:
      - rid: 4311677738384359720
  - m_Id: 2851221118759219
    m_Localized: "Es un h\xE9roe de DC que combate el crimen usando entrenamiento,
      tecnolog\xEDa e inteligencia."
    m_Metadata:
      m_Items:
      - rid: 4311677738384359721
  - m_Id: 2851221118759220
    m_Localized: Superman
    m_Metadata:
      m_Items:
      - rid: 4311677738384359722
  - m_Id: 2851221118759221
    m_Localized: "Es un superh\xE9roe de DC con fuerza, vuelo y poderes derivados
      del sol amarillo."
